# Local development / Docker Compose template
POSTGRES_DB=finansal_yonetim
POSTGRES_USER=finansal_user
POSTGRES_PASSWORD=change_me

# Used when running Prisma/backend directly on the host.
# Docker Compose builds its service-to-service DATABASE_URL from POSTGRES_* above.
DATABASE_URL=postgresql://finansal_user:change_me@localhost:5432/finansal_yonetim?schema=public

JWT_SECRET=change_me_to_a_long_random_secret
REDIS_URL=redis://redis:6379
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

GRAFANA_ADMIN_PASSWORD=change_me
